# Hardware profile for the current EC2 A10G-class experiment machine.
#
# These values preserve the pressure scale used by the latest native-harness
# deadline-pressure report. Callers may override any value before sourcing this
# profile, for example: MAX_TOTAL_TOKENS=32768 HARDWARE_PROFILE=ec2_a10g ...

: "${MAX_TOTAL_TOKENS:=24576}"
: "${HICACHE_SIZE_GB:=8}"
: "${MEM_FRACTION_STATIC:=0.72}"
: "${REPORT_BUILDER_MODE:=lightweight}"
: "${GPU_UTIL_SAMPLE_INTERVAL_MS:=100}"

: "${P0_CONTROL_KNOBS:=tool_wait_ms=500 target_prompt_tokens=1024 filler_sessions=0 filler_prompt_tokens=768 session_count=1 concurrency=1}"
: "${P1_MILD_KNOBS:=tool_wait_ms=250 target_prompt_tokens=2048 filler_sessions=8 filler_prompt_tokens=1024 session_count=1 concurrency=4}"
: "${P2_MEDIUM_KNOBS:=tool_wait_ms=100 target_prompt_tokens=3072 filler_sessions=16 filler_prompt_tokens=1536 session_count=1 concurrency=6}"
: "${P3_HIGH_KNOBS:=tool_wait_ms=50 target_prompt_tokens=4096 filler_sessions=32 filler_prompt_tokens=1536 session_count=1 concurrency=8}"
: "${P4_CLIFF_KNOBS:=tool_wait_ms=25 target_prompt_tokens=4096 filler_sessions=48 filler_prompt_tokens=2048 session_count=1 concurrency=10}"
: "${P5_BOSS_QUEUE_KNOBS:=tool_wait_ms=50 target_prompt_tokens=4096 filler_sessions=4 filler_prompt_tokens=2048 session_count=4 concurrency=12}"
