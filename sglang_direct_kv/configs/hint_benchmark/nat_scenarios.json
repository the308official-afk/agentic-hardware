        "task": "single simple coding-agent turn",
        "request_count": 1,
        "tool_waits": 0,
        "shared_prefix": false,
        "cache_control": "disabled",
        "priority": "unset"
      },
      "synthetic_setup": {
        "description": "Run one ordinary NAT request with all benchmark hint knobs unset.",
        "client_metadata": {},
        "workflow_metadata": {},
        "provider_metadata": {}
