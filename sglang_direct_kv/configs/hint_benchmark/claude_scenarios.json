  "injection_levels": {
    "provider_level": "Provider or client setting attached outside the task body.",
    "session_level": "Attached to a whole client/session configuration.",
    "workflow_level": "Attached to a workflow or multi-step agent path.",
    "request_level": "Attached to one model request body.",
    "content_block_level": "Attached to a tool, system, message, or content block.",
    "cache_entry_level": "Attached to a cache-control breakpoint or cache entry.",
    "runtime_feedback_level": "Reported after backend/provider execution."
  },
  "scenarios": [
    {
      "id": "claude_no_hints_baseline",
      "display_name": "Claude native baseline",
      "status": "native_client_required",
      "source_class": "client_supplied",
      "injection_level": "request_level",
      "scope": "request",
      "trigger_type": "control",
      "target_hint_ids": [],
      "benchmark_question": "What fields appear when the real Claude client sends a minimal one-turn request?",
      "workload_shape": {"request_count": 1, "client": "claude_cli"},
      "client_setup": {
        "cli_prompt": "Hint benchmark baseline. Reply with one short sentence."
      },
      "expected_emissions": [],
      "negative_expectations": [
        {"hint_id": "provider_qos", "raw_field": "service_tier", "expected_value": "present"},
        {"hint_id": "cache_control", "raw_field": "cache_control.type", "expected_value": "present"}
      ]
    },
    {
      "id": "claude_service_tier_auto",
      "display_name": "Claude native service tier auto",
      "status": "native_client_required",
      "source_class": "provider_config",
      "injection_level": "session_level",
      "scope": "provider",
      "trigger_type": "configured_provider_qos",
      "target_hint_ids": ["provider_qos"],
      "benchmark_question": "Does a Claude session/client QoS setting appear as service_tier=auto at the request boundary?",
      "workload_shape": {"request_count": 1, "client": "claude_cli"},
      "client_setup": {
        "env": {
          "ANTHROPIC_SERVICE_TIER": "auto",
          "CLAUDE_CODE_SERVICE_TIER": "auto"
        },
        "cli_prompt": "Hint benchmark service tier auto probe. Reply with one short sentence."
      },
      "expected_emissions": [
        {"hint_id": "provider_qos", "raw_field": "service_tier", "expected_value": "auto", "required": true}
      ],
      "notes": "If this does not appear, the tested Claude client may not expose service_tier through this configuration path."
    },
    {
      "id": "claude_service_tier_standard_only",
      "display_name": "Claude native service tier standard-only",
      "status": "native_client_required",
      "source_class": "provider_config",
      "injection_level": "session_level",
      "scope": "provider",
      "trigger_type": "configured_provider_qos",
      "target_hint_ids": ["provider_qos"],
      "benchmark_question": "Does a Claude session/client QoS setting appear as service_tier=standard_only at the request boundary?",
      "workload_shape": {"request_count": 1, "client": "claude_cli"},
      "client_setup": {
        "env": {
          "ANTHROPIC_SERVICE_TIER": "standard_only",
          "CLAUDE_CODE_SERVICE_TIER": "standard_only"
        },
        "cli_prompt": "Hint benchmark service tier standard only probe. Reply with one short sentence."
      },
      "expected_emissions": [
        {"hint_id": "provider_qos", "raw_field": "service_tier", "expected_value": "standard_only", "required": true}
      ],
      "notes": "This is a native-client probe. Failure means this client/config path did not emit the field."
    },
    {
      "id": "claude_fast_mode_setting",
      "display_name": "Claude native fast mode setting",
      "status": "native_fast_mode_access_required",
      "source_class": "provider_config",
      "injection_level": "session_level",
      "scope": "provider",
      "trigger_type": "configured_fast_mode",
      "target_hint_ids": ["provider_qos"],
      "benchmark_question": "Does Claude Code fastMode=true appear at the provider request boundary?",
      "workload_shape": {"request_count": 1, "client": "claude_cli", "fast_mode": true},
      "client_setup": {
        "cli_args": [
          "--settings",
          "{\"fastMode\":true}",
          "-p",
          "Hint benchmark fast mode probe. Reply with one short sentence.",
          "--output-format",
          "json"
        ]
      },
      "expected_emissions": [
        {
          "hint_id": "provider_qos",
          "raw_field": "_capture.headers.anthropic-beta",
          "expected_value": {"contains": "fast-mode"},
          "required": true
        }
      ],
      "notes": "Claude Code documents fast mode as a client setting that affects provider routing/cache key behavior. This scenario may fail when the installed client/account/model does not support fast mode."
    },
    {
      "id": "claude_repeated_session_prefix",
      "display_name": "Claude repeated session prefix",
      "status": "native_client_required",
      "source_class": "provider_automatic",
      "injection_level": "cache_entry_level",
      "scope": "cache",
      "trigger_type": "repeated_identical_prefix",
      "target_hint_ids": ["cache_key_bucket"],
      "benchmark_question": "Does repeated identical client context expose any client-visible cache-key or exact-prefix evidence?",
      "workload_shape": {"request_count": 2, "client": "claude_cli", "stable_prefix": true},
      "client_setup": {
        "cli_prompt": "Hint benchmark repeated prefix probe turn {invocation_index}. Use the same stable repository context and reply briefly."
      },
      "expected_emissions": [
        {
          "hint_id": "cache_key_bucket",
          "raw_field": "cache_key_policy",
          "expected_value": "provider_exact_prefix_hash",
          "required": false
        }
      ],
      "notes": "Claude prompt cache matching is provider-derived and may not expose a literal request field."
    },
    {
      "id": "claude_long_running_cache_session",
      "display_name": "Claude long-running cache session",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "content_block_level",
      "scope": "request_or_cache_entry",
      "trigger_type": "long_running_reusable_context",
      "target_hint_ids": ["cache_control", "cache_entry_type"],
      "benchmark_question": "Does the real Claude prompt builder add cache_control when stable context is reused across turns?",
      "workload_shape": {"request_count": 3, "client": "claude_cli", "stable_prefix": true},
      "client_setup": {
        "cli_prompt": "Hint benchmark long-running cache session turn {invocation_index}. Reuse stable instructions and answer briefly."
      },
      "expected_emissions": [
        {"hint_id": "cache_control", "raw_field": "system.*.cache_control.type", "expected_value": "ephemeral", "required": true},
        {"hint_id": "cache_control", "raw_field": "messages.*.content.*.cache_control.type", "expected_value": "ephemeral", "required": true}
      ],
      "notes": "This is the main organic Claude Code cache-control probe."
    },
    {
      "id": "claude_tool_heavy_request",
      "display_name": "Claude tool-heavy request",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "content_block_level",
      "scope": "tools",
      "trigger_type": "stable_tool_definition",
      "target_hint_ids": ["cache_control", "cache_entry_type"],
      "benchmark_question": "Does the real Claude client mark stable tool definitions with cache_control?",
      "workload_shape": {"request_count": 1, "client": "claude_cli", "tool_use_expected": true},
      "client_setup": {
        "cli_prompt": "Hint benchmark tool probe. Inspect this repository at a high level and reply with one short sentence."
      },
      "expected_emissions": [
        {
          "hint_id": "cache_control",
          "raw_field": "tools.*.cache_control.type",
          "expected_value": "ephemeral",
          "required": false
        }
      ],
      "notes": "Claude Code may cache stable system/message context even when tool definitions themselves are not marked."
    },
    {
      "id": "claude_stable_system_context",
      "display_name": "Claude stable system context",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "content_block_level",
      "scope": "system",
      "trigger_type": "stable_system_block",
      "target_hint_ids": ["cache_control", "cache_entry_type"],
      "benchmark_question": "Does the real Claude client mark stable system/developer context with cache_control?",
      "workload_shape": {"request_count": 2, "client": "claude_cli", "stable_prefix": true},
      "client_setup": {
        "cli_prompt": "Hint benchmark stable system context turn {invocation_index}. Keep the same role and answer briefly."
      },
      "expected_emissions": [
        {
          "hint_id": "cache_control",
          "raw_field": "system.*.cache_control.type",
          "expected_value": "ephemeral",
          "required": true
        }
      ]
    },
    {
      "id": "claude_stable_message_context",
      "display_name": "Claude stable message context",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "content_block_level",
      "scope": "messages",
      "trigger_type": "stable_message_block",
      "target_hint_ids": ["cache_control", "cache_entry_type"],
      "benchmark_question": "Does the real Claude client mark stable message blocks with cache_control?",
      "workload_shape": {"request_count": 2, "client": "claude_cli", "stable_prefix": true},
      "client_setup": {
        "cli_prompt": "Hint benchmark stable message context turn {invocation_index}. Reuse this stable paragraph exactly: alpha beta gamma delta."
      },
      "expected_emissions": [
        {
          "hint_id": "cache_control",
          "raw_field": "messages.*.content.*.cache_control.type",
          "expected_value": "ephemeral",
          "required": true
        }
      ]
    },
    {
      "id": "claude_prewarm_like_probe",
      "display_name": "Claude prewarm-like probe",
      "status": "native_client_required",
      "source_class": "client_supplied",
      "injection_level": "request_level",
      "scope": "request_or_cache_entry",
      "trigger_type": "prewarm_request",
      "target_hint_ids": ["speculative_prewarm", "cache_control"],
      "benchmark_question": "Can the real Claude client emit a prewarm-like request shape with max_tokens=0 and cache_control?",
      "workload_shape": {"request_count": 1, "client": "claude_cli"},
      "client_setup": {
        "cli_args": ["-p", "Hint benchmark prewarm-like probe. Reply with no more than one word.", "--output-format", "json"]
      },
      "expected_emissions": [
        {"hint_id": "speculative_prewarm", "raw_field": "max_tokens", "expected_value": 0, "required": true},
        {"hint_id": "cache_control", "raw_field": "system.*.cache_control.type", "expected_value": "ephemeral", "required": true}
      ],
      "notes": "If the CLI does not offer a max_tokens=0 path, this should fail as unsupported for native Claude Code."
    },
    {
      "id": "claude_provider_cache_feedback_probe",
      "display_name": "Claude provider cache feedback probe",
      "status": "real_provider_required",
      "source_class": "metrics_feedback",
      "injection_level": "runtime_feedback_level",
      "scope": "usage",
      "trigger_type": "post_execution_usage",
      "target_hint_ids": ["cache_hit_feedback"],
      "benchmark_question": "Does a real Claude provider response include cache read/write token counters?",
      "workload_shape": {"request_count": 1, "client": "claude_cli", "real_provider_response_required": true},
      "client_setup": {
        "cli_prompt": "Hint benchmark provider feedback probe. Reply with one short sentence."
      },
      "expected_emissions": [
        {
          "hint_id": "cache_hit_feedback",
          "raw_field": "usage.cache_creation_input_tokens",
          "expected_value": {"numeric_range": [1, 1000000]},
          "required": true
        },
        {
          "hint_id": "cache_hit_feedback",
          "raw_field": "usage.cache_read_input_tokens",
          "expected_value": {"numeric_range": [1, 1000000]},
          "required": true
        }
      ],
      "notes": "The local capture endpoint can record requests, but real cache feedback needs a real provider/backend response path."
    },
    {
      "id": "claude_provider_retention_1h",
      "display_name": "Claude provider-managed 1h retention",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "cache_entry_level",
      "scope": "cache_entry",
      "trigger_type": "long_running_session_cache_retention",
      "target_hint_ids": ["cache_pinning", "cache_ttl"],
      "benchmark_question": "Does the real Claude client expose any explicit cache TTL when configured for long retention?",
      "workload_shape": {"request_count": 2, "client": "claude_cli", "stable_prefix": true},
      "client_setup": {
        "env": {
          "ENABLE_PROMPT_CACHING_1H": "1"
        },
        "cli_prompt": "Hint benchmark long cache retention probe turn {invocation_index}. Reuse stable context and answer briefly."
      },
      "expected_emissions": [
        {"hint_id": "cache_control", "raw_field": "system.*.cache_control.type", "expected_value": "ephemeral", "required": true},
        {"hint_id": "cache_ttl", "raw_field": "system.*.cache_control.ttl", "expected_value": "present", "required": false},
        {"hint_id": "cache_ttl", "raw_field": "messages.*.content.*.cache_control.ttl", "expected_value": "present", "required": false},
        {"hint_id": "cache_ttl", "raw_field": "_capture.headers.anthropic-beta", "expected_value": "present", "required": false}
      ],
      "negative_expectations": [
        {"hint_id": "cache_pinning", "raw_field": "cache_pinning", "expected_value": "present"}
      ],
      "notes": "Claude Code documents ENABLE_PROMPT_CACHING_1H=1 as the long-retention knob. TTL may appear as body cache_control.ttl, a beta/header behavior, or post-execution cache_creation detail depending on provider path."
    },
    {
      "id": "claude_provider_retention_5m",
      "display_name": "Claude provider-managed 5m retention",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "cache_entry_level",
      "scope": "cache_entry",
      "trigger_type": "default_cache_retention_control",
      "target_hint_ids": ["cache_ttl", "cache_control"],
      "benchmark_question": "Does the real Claude client expose cache-control evidence when forced to use 5-minute prompt caching?",
      "workload_shape": {"request_count": 2, "client": "claude_cli", "stable_prefix": true},
      "client_setup": {
        "env": {
          "FORCE_PROMPT_CACHING_5M": "1"
        },
        "cli_prompt": "Hint benchmark five minute cache retention probe turn {invocation_index}. Reuse stable context and answer briefly."
      },
      "expected_emissions": [
        {"hint_id": "cache_control", "raw_field": "system.*.cache_control.type", "expected_value": "ephemeral", "required": true},
        {"hint_id": "cache_ttl", "raw_field": "system.*.cache_control.ttl", "expected_value": "present", "required": false},
        {"hint_id": "cache_ttl", "raw_field": "messages.*.content.*.cache_control.ttl", "expected_value": "present", "required": false}
      ],
      "negative_expectations": [
        {"hint_id": "cache_pinning", "raw_field": "cache_pinning", "expected_value": "present"}
      ],
      "notes": "This is the documented short-retention knob. It mainly proves cache-control emission and gives a contrast against ENABLE_PROMPT_CACHING_1H."
    },
    {
      "id": "claude_cache_pinning_negative_probe",
      "display_name": "Claude cache pinning negative probe",
      "status": "native_client_required",
      "source_class": "prompt_builder_policy",
      "injection_level": "cache_entry_level",
      "scope": "cache_entry",
      "trigger_type": "negative_pin_field_check",
      "target_hint_ids": ["cache_pinning"],
      "benchmark_question": "Confirm whether the real Claude client emits a literal cache_pinning field.",
      "workload_shape": {"request_count": 1, "client": "claude_cli"},
      "client_setup": {
        "cli_prompt": "Hint benchmark cache pinning negative probe. Reply with one short sentence."
      },
      "expected_emissions": [],
      "negative_expectations": [
        {"hint_id": "cache_pinning", "raw_field": "cache_pinning", "expected_value": "present"}
      ],
      "notes": "This should normally pass by absence; Claude documents TTL/cache_control, not cache_pinning=true."
    },
    {
      "id": "claude_api_fast_mode",
      "display_name": "Claude direct API fast mode",
      "status": "direct_api_payload_supported",
      "source_class": "direct_api_client_supplied",
      "injection_level": "request_level",
      "scope": "provider",
      "trigger_type": "direct_api_fast_speed_request",
      "target_hint_ids": ["provider_qos"],
      "benchmark_question": "Can the benchmark represent Anthropic API fast mode as request speed plus beta header and response speed feedback?",
      "workload_shape": {"request_count": 1, "client": "anthropic_messages_api"},
      "client_setup": {
        "api_headers": {
          "anthropic-beta": "fast-mode-2026-02-01"
        },
        "api_payload": {
          "model": "claude-opus-5",
          "max_tokens": 8,
          "speed": "fast",
          "messages": [{"role": "user", "content": "Direct API fast-mode benchmark probe."}]
        },
        "api_response_payload": {
          "usage": {
            "input_tokens": 8,
            "output_tokens": 4,
            "speed": "fast"
          }
        }
      },
      "expected_emissions": [
        {"hint_id": "provider_qos", "raw_field": "speed", "expected_value": "fast", "required": true},
        {"hint_id": "provider_qos", "raw_field": "_capture.headers.anthropic-beta", "expected_value": "fast-mode-2026-02-01", "required": true},
        {"hint_id": "provider_qos", "raw_field": "usage.speed", "expected_value": "fast", "required": true}
      ],
      "notes": "This is a direct API capability probe, not proof that Claude Code CLI organically emitted fast mode."
    },
    {
      "id": "claude_bedrock_service_tier_priority",
      "display_name": "Claude Bedrock service-tier priority",
      "status": "provider_config_payload_supported",
      "source_class": "provider_config",
      "injection_level": "provider_level",
      "scope": "provider",
      "trigger_type": "bedrock_service_tier_config",
      "target_hint_ids": ["provider_qos"],
      "benchmark_question": "Can the benchmark represent Bedrock service-tier priority as a provider-level request header?",
      "workload_shape": {"request_count": 1, "client": "bedrock_provider_config"},
      "client_setup": {
        "api_headers": {
          "x-amzn-bedrock-service-tier": "priority"
        },
        "api_payload": {
          "model": "anthropic.claude-opus-5",
          "max_tokens": 8,
          "messages": [{"role": "user", "content": "Bedrock service-tier benchmark probe."}]
        }
      },
      "expected_emissions": [
        {
          "hint_id": "provider_qos",
          "raw_field": "_capture.headers.x-amzn-bedrock-service-tier",
          "expected_value": "priority",
          "required": true
        }
      ],
      "notes": "This is a provider-config lane. It should not be counted as native Anthropic API or native Claude Code CLI emission."
    },
    {
      "id": "claude_api_cache_ttl_1h",
      "display_name": "Claude direct API explicit cache TTL",
      "status": "direct_api_payload_supported",
      "source_class": "direct_api_client_supplied",
      "injection_level": "cache_entry_level",
      "scope": "cache_entry",
      "trigger_type": "direct_api_explicit_cache_ttl",
      "target_hint_ids": ["cache_control", "cache_ttl", "cache_pinning"],
      "benchmark_question": "Can the benchmark represent explicit Anthropic API cache TTL on reusable prompt blocks?",
      "workload_shape": {"request_count": 1, "client": "anthropic_messages_api", "stable_prefix": true},
      "client_setup": {
        "api_payload": {
          "model": "claude-opus-5",
          "max_tokens": 8,
          "system": [
            {
              "type": "text",
              "text": "Stable system context for direct API TTL probe.",
              "cache_control": {"type": "ephemeral", "ttl": "1h"}
            }
          ],
          "messages": [{"role": "user", "content": "Use the cached system prefix."}]
        }
      },
      "expected_emissions": [
        {"hint_id": "cache_control", "raw_field": "system.*.cache_control.type", "expected_value": "ephemeral", "required": true},
        {"hint_id": "cache_ttl", "raw_field": "system.*.cache_control.ttl", "expected_value": "1h", "required": true},
        {"hint_id": "cache_pinning", "raw_field": "system.*.cache_control.ttl", "expected_value": "1h", "required": true}
      ],
      "notes": "This models long-retention cache behavior through TTL. It does not use or expect a literal cache_pinning=true field."
    },
    {
      "id": "claude_api_prewarm_max_tokens_zero",
      "display_name": "Claude direct API max_tokens=0 prewarm",
      "status": "direct_api_payload_supported",
      "source_class": "direct_api_client_supplied",
      "injection_level": "request_level",
      "scope": "request_or_cache_entry",
      "trigger_type": "direct_api_prewarm_request",
      "target_hint_ids": ["speculative_prewarm", "cache_control", "cache_hit_feedback"],
      "benchmark_question": "Can the benchmark represent a true Anthropic API prompt-cache prewarm using max_tokens=0?",
      "workload_shape": {"request_count": 1, "client": "anthropic_messages_api", "stable_prefix": true},
      "client_setup": {
        "api_payload": {
          "model": "claude-opus-5",
          "max_tokens": 0,
          "system": [
            {
              "type": "text",
              "text": "Large stable context that should be written to prompt cache.",
              "cache_control": {"type": "ephemeral"}
            }
          ],
          "messages": [{"role": "user", "content": "Prewarm this prefix."}]
        },
        "api_response_payload": {
          "content": [],
          "usage": {
            "input_tokens": 8,
            "cache_creation_input_tokens": 5120,
            "cache_read_input_tokens": 0,
            "output_tokens": 0
          }
        }
      },
      "expected_emissions": [
        {"hint_id": "speculative_prewarm", "raw_field": "max_tokens", "expected_value": 0, "required": true},
