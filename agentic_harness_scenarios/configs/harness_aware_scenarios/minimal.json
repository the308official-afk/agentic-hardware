  "scenarios": [
    {
      "scenario_id": "deadline_scheduling_minimal",
      "brief_claim": "Better deadline scheduling",
      "scenario_type": "deadline_scheduling",
      "description": "An urgent user-facing replay becomes ready while a long background prefill is queued.",
      "harness_signals": {
        "session_id": "support_agent",
        "prefix_id": "support_agent_prefix",
        "phase": "replay_ready",
        "deadline_after_ready_ms": 100,
        "priority": 100,
        "user_waiting": true
      },
      "backend_state": {
        "background_prefill_ms": 260,
        "urgent_service_ms": 35
      },
      "baseline_policy": "fifo_static_queue",
      "harness_aware_policy": "deadline_priority_scheduler",
      "expected_benefit": "Urgent replay runs before background prefill and meets its first-token deadline.",
      "chart": "lateness_bar"
    },
    {
